{
  "manifest_version": 3,
  "name": "GPhoto2MyCloud",
  "version": "3.1.0",
  "description": "Scarica Google Foto dall'interfaccia web e trasferisce i file su My Cloud.",
  "key": "",
  "permissions": ["activeTab", "debugger", "downloads", "nativeMessaging", "sidePanel", "storage", "tabs"],
  "host_permissions": ["https://photos.google.com/*"],
  "background": {"service_worker": "service-worker.js"},
  "action": {"default_title": "Apri GPhoto2MyCloud 3.1 Production"},
  "side_panel": {"default_path": "sidepanel.html"},
  "content_scripts": [{
    "matches": ["https://photos.google.com/*"],
    "js": ["planner.js", "automation.js"],
    "run_at": "document_idle"
  }]
}
